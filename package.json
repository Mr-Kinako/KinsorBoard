{
  "name": "kinsorboard",
  "private": true,
  "version": "0.1.0-alpha.15",
  "type": "module",
  "scripts": {
    "watch": "vite build --watch",
    "preview": "vite preview",
    "build": "tsc -b && vite build",
    "build:watch": "concurrently \"vite build --watch\" \"vite preview\"",
    "format": "prettier --write .",
    "checks": "concurrently \"prettier --check .\" \"steiger ./src\" \"eslint .\""
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@feature-sliced/steiger-plugin": "^0.8.2",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-router": "^5.1.20",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.7",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "sass": "^1.108.1",
    "sass-embedded": "^1.108.1",
    "steiger": "^0.10.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true
  }
}
